// Nureke Digital — Studio CRM схемасы.
// P1-де тек Lead кестесі. Activity, Proposal, CaseStudy кестелері P2/P3-те
// қосылады — docs/architecture/06-mvp-architecture.md.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadSource {
  WEBSITE
  CALCULATOR
  AI_CONSULTANT
  OUTBOUND
  REFERRAL
}

enum ProjectType {
  AI_AUTOMATION
  MOBILE
  MINIAPP
  WEBSITE
  CRM
  UNKNOWN
}

enum BudgetRange {
  UNDER_1M
  FROM_1M_TO_3M
  FROM_3M_TO_10M
  OVER_10M
  UNKNOWN
}

enum Temperature {
  HOT
  WARM
  COLD
}

enum PipelineStatus {
  NEW
  QUALIFIED
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  PROJECT
  DELIVERED
  SUPPORT
}

model Lead {
  id           String         @id @default(cuid())
  name         String
  company      String?
  phone        String
  email        String?
  source       LeadSource     @default(WEBSITE)
  projectType  ProjectType    @default(UNKNOWN)
  budgetRange  BudgetRange    @default(UNKNOWN)
  message      String?
  pageUrl      String?
  score        Int            @default(0)
  temperature  Temperature    @default(COLD)
  status       PipelineStatus @default(NEW)
  nextAction   String?
  nextActionAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([temperature])
}
